# TomeForge Docker Environment Configuration
#
# This file contains environment variables for Docker infrastructure services.
# This is SEPARATE from the application .env file (which configures the backend/frontend).
#
# USAGE:
#   1. Copy this file to .env.docker: cp .env.docker.example .env.docker
#   2. Customize credentials if desired (or use defaults for local development)
#   3. Start services: docker compose up -d
#
# SECURITY WARNING:
#   These are DEVELOPMENT-ONLY credentials. DO NOT use these in production.
#   The .env.docker file is gitignored and should NEVER be committed.

# ============================================
# MongoDB Root Credentials
# ============================================
# These credentials are used for MongoDB container initialization
# The root user has full administrative access to all databases

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=devpassword123
MONGO_INITDB_DATABASE=tomeforge

# ============================================
# MongoDB Application User
# ============================================
# These credentials are created by the initialization script (docker/mongo-init/init-user.js)
# The backend application uses this user to connect to the database
# This user has readWrite permissions ONLY on the tomeforge database
#
# IMPORTANT: Update your backend .env file with these credentials:
#   MONGODB_URI=mongodb://tomeforge_app:apppassword123@localhost:27017/tomeforge
# OR:
#   MONGODB_USERNAME=tomeforge_app
#   MONGODB_PASSWORD=apppassword123
#   MONGODB_CLUSTER=localhost:27017
#   MONGODB_DATABASE_NAME=tomeforge

MONGODB_APP_USERNAME=tomeforge_app
MONGODB_APP_PASSWORD=apppassword123

# ============================================
# mongo-express Web UI Configuration
# ============================================
# Access mongo-express at http://localhost:8081
# You will be prompted for these credentials when accessing the web UI

# mongo-express basic authentication (for accessing the web UI)
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=express123

# MongoDB admin credentials for mongo-express to connect to MongoDB
# These should match the MongoDB root credentials above
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=devpassword123

# MongoDB connection URL for mongo-express
# Uses the Docker network service name "mongodb" with admin credentials
ME_CONFIG_MONGODB_URL=mongodb://admin:devpassword123@mongodb:27017/
