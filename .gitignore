# TomeForge .gitignore - Comprehensive Monorepo Template

# ============================================
# DEPENDENCIES
# ============================================
node_modules/
pnpm-lock.yaml
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ============================================
# BUILD OUTPUTS
# ============================================
out/
dist/
build/
*.tsbuildinfo
.cache/
.parcel-cache/

# ============================================
# GENERATED API DOCUMENTATION
# ============================================
apps/backend/src/generated/
apps/backend/openapi.json
docs/openapi.json

# ============================================
# ENVIRONMENT & SECRETS
# ============================================
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
credentials/
secrets/

# ============================================
# LOGS & DEBUGGING
# ============================================
logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# IDE & EDITOR FILES
# ============================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# TESTING & COVERAGE
# ============================================
*.suo
*.ntvs*
*.njsproj
*.sln
fixtures/local/
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ============================================
# TEMPORARY & SYSTEM FILES
# ============================================
tmp/
temp/
*.tmp
*.temp
.temp/
.tmp/

# ============================================
# DATABASE & LOCAL DATA
# ============================================
*.sqlite
*.db
data/
uploads/
ehthumbs.db
Desktop.ini

# ============================================
# DOCKER
# ============================================
docker-compose.override.yml

# ============================================
# MONOREPO SPECIFIC
# ============================================
.turbo/
.pnpm-store/

# ============================================
# LOCAL DEVELOPMENT (keep out of git)
# ============================================
# Personal notes and TODOs
tasks/
NOTES.md
*_TODO.md
scratch/
.eslintcache
*.bak
*.orig
