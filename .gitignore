# TomeForge .gitignore - Comprehensive Monorepo Template

# ============================================
# DEPENDENCIES
# ============================================
node_modules/
pnpm-lock.yaml
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ============================================
# BUILD OUTPUTS
# ============================================
out/
dist/
build/
*.tsbuildinfo
.cache/
.parcel-cache/

# ============================================
# GENERATED API DOCUMENTATION
# ============================================
apps/backend/src/generated/
apps/backend/openapi.json
docs/openapi.json

# ============================================
# ENVIRONMENT & SECRETS
# ============================================
.env
.env.*
!.env.example
!.env.template
!.env.docker.example
*.pem
*.key
*.p12
*.pfx
credentials/
secrets/

# ============================================
# LOGS & DEBUGGING
# ============================================
logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# IDE & EDITOR FILES
# ============================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# TESTING & COVERAGE
# ============================================
*.suo
*.ntvs*
*.njsproj
*.sln
fixtures/local/
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ============================================
# TEMPORARY & SYSTEM FILES
# ============================================
tmp/
temp/
*.tmp
*.temp
.temp/
.tmp/

# ============================================
# DATABASE & LOCAL DATA
# ============================================
*.sqlite
*.db
data/
uploads/
ehthumbs.db
Desktop.ini

# ============================================
# DOCKER
# ============================================
docker-compose.override.yml

# ============================================
# MONOREPO SPECIFIC
# ============================================
.turbo/
.pnpm-store/

# ============================================
# LOCAL DEVELOPMENT (keep out of git)
# ============================================
# Personal notes and TODOs
tasks/
NOTES.md
*_TODO.md
scratch/
.eslintcache
*.bak
*.orig

# ============================================
# AI & CLAUDE CODE
# ============================================
# Local Claude settings (personal/machine-specific)
.claude/settings.local.json
.claude/**/*.local.json

# Claude session data and logs
.claude/sessions/
.claude/logs/
.claude/.cache/

# AI chat transcripts and scratch work
.ai-transcripts/
.ai-scratch/
*.ai-chat.md

# Cursor/other AI IDEs (if used in future)
.cursor/settings.local.json
.cursor/sessions/

# ============================================
# AGENT-OS WORKING FILES
# ============================================
# Detailed implementation/verification logs (keep only spec.md and tasks.md)
agent-os/specs/*/implementation/
agent-os/specs/*/verification/
agent-os/specs/*/planning/initialization.md
agent-os/specs/*/planning/task-assignments.yml

# Archive directory for completed spec artifacts
agent-os/specs/archive/

# Temporary agent work files
agent-os/.tmp/
agent-os/scratch/

# Personal developer notes
agent-os/personal/
agent-os/**/*.personal.md
agent-os/**/*_PRIVATE.md
