{
  "name": "tomeforge",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "pnpm exec rimraf apps/backend/dist apps/frontend/dist packages/shared/dist",
    "build-api-schemas": "node scripts/generate-api-schemas.js",
    "build-api-spec": "node scripts/generate-openapi.js",
    "build-api-docs": "pnpm build-api-schemas && pnpm build-api-spec",
    "build": "pnpm -r exec tsc && pnpm build-api-spec",
    "build-typedoc": "cd packages/shared && pnpm exec typedoc",
    "build-docs": "pnpm build-api-spec && pnpm build-typedoc && node sync-docs.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start-backend": "cd apps/backend && pnpm run dev",
    "start-frontend": "cd apps/frontend && pnpm run dev",
    "start": "concurrently \"pnpm start-backend\" \"pnpm start-frontend\""
  },
  "keywords": [],
  "author": "CurtLeaf",
  "license": "MIT",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "concurrently": "^8.2.0",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.1.0",
    "rimraf": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript-json-schema": "^0.65.1"
  },
  "dependencies": {
    "docsify-cli": "^4.4.4"
  }
}
